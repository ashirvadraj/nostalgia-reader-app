<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Horizontal Page Turning ViewPager2 (Complete Illustrated Reading Mode) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerReader"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Live Official ePaper Web View (Broadsheet ePaper Mode) -->
    <WebView
        android:id="@+id/webViewEpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Top Overlay Toolbar (Auto-hideable) -->
    <LinearLayout
        android:id="@+id/toolbarTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D9121214"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btnReaderBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReaderPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ePaper Live View Toggle (for Daily Newspapers) -->
        <ImageView
            android:id="@+id/btnToggleEpaper"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_globe"
            android:visibility="gone"
            app:tint="@color/accent" />

        <!-- Theme Toggle (Parchment, Sepia, Night) -->
        <ImageView
            android:id="@+id/btnThemeToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_palette"
            app:tint="@color/text_primary" />

        <!-- Bookmark Toggle -->
        <ImageView
            android:id="@+id/btnReaderBookmark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Bottom Controls Overlay (Auto-hideable) -->
    <LinearLayout
        android:id="@+id/toolbarBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D9121214"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <Button
            android:id="@+id/btnPrevPage"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip"
            android:minWidth="60dp"
            android:text="← पिछला"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/seekBarPages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:progressBackgroundTint="@color/divider"
            android:progressTint="@color/accent"
            android:thumbTint="@color/primary" />

        <Button
            android:id="@+id/btnNextPage"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip"
            android:minWidth="60dp"
            android:text="अगला →"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
