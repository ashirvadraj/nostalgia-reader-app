<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 महीना व वर्ष का अंक चुनें"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="चंपक, नंदन, चंदामामा का किसी भी महीने का अंक खोजें (जैसे अगस्त 2026)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Series Label & Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="पत्रिका / कॉमिक चुनें (Select Magazine)"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerSeries"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="12dp" />

    <!-- Month Label & Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="महीना चुनें (Select Month)"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerMonth"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="12dp" />

    <!-- Year Label & Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="वर्ष चुनें (Select Year)"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerYear"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="12dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/btnFetchIssueSubmit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_gradient"
        android:text="अंक प्राप्त करें व पढ़ें (Fetch &amp; Read)"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
